#!/bin/sh
# Blocks the push when lint, tests, or build fail.
cd "$(git rev-parse --show-toplevel)" || exit 1

if command -v npm >/dev/null 2>&1; then
  NPM=npm
elif command -v npm.cmd >/dev/null 2>&1; then
  NPM=npm.cmd
else
  echo "pre-push bloqueado: no se encontró npm en PATH"
  exit 1
fi

run_step() {
  name="$1"
  script="$2"
  echo "pre-push: $name"
  if "$NPM" run "$script"; then
    return 0
  fi
  echo "pre-push bloqueado: falló $name"
  exit 1
}

run_step "lint" "lint"
run_step "tests" "test:check"
run_step "build" "build"

echo "pre-push: lint, tests y build OK"
exit 0
