        {
          "name": "Última página del catálogo",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/instruments?page={{catalogPage}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "instruments"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "{{catalogPage}}"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.sendRequest(pm.variables.get('baseUrl') + '/instruments', function (error, response) {",
                  "  if (error) throw error;",
                  "  if (response.code !== 200) throw new Error('No se pudo leer el total del catálogo');",
                  "  const totalItems = response.json().pagination.totalItems;",
                  "  if (!Number.isSafeInteger(totalItems) || totalItems < 0) throw new Error('Total de instrumentos inválido');",
                  "  const totalPages = Math.ceil(totalItems / 20);",
                  "  const page = Math.max(1, totalPages);",
                  "  pm.variables.set('catalogPage', String(page));",
                  "  pm.variables.set('catalogTotalItems', String(totalItems));",
                  "});"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Última página del catálogo', function () {",
                  "  pm.response.to.have.status(200);",
                  "  const { items, pagination } = pm.response.json();",
                  "  const expectedPage = Number(pm.variables.get('catalogPage'));",
                  "  const expectedPageSize = 20;",
                  "  pm.expect(pagination.page, 'page').to.eql(expectedPage);",
                  "  pm.expect(pagination.pageSize, 'pageSize').to.eql(expectedPageSize);",
                  "  const totalItems = pagination.totalItems;",
                  "  pm.expect(Number.isSafeInteger(totalItems) && totalItems >= 0, 'totalItems entero no negativo').to.be.true;",
                  "  pm.expect(totalItems, 'totalItems debe coincidir con la primera página').to.eql(Number(pm.variables.get('catalogTotalItems')));",
                  "  pm.expect(pagination.totalPages, 'totalPages').to.eql(Math.ceil(totalItems / expectedPageSize));",
                  "  const remaining = totalItems - (expectedPage - 1) * expectedPageSize;",
                  "  const expectedItems = Math.max(0, Math.min(expectedPageSize, remaining));",
                  "  pm.expect(items).to.be.an('array').with.lengthOf(expectedItems);",
                  "  items.forEach(function (instrument) {",
                  "    pm.expect(instrument).to.have.all.keys('id', 'ticker', 'name', 'type');",
                  "    pm.expect(instrument.ticker).not.to.eql('ARS');",
                  "    pm.expect(instrument.type).not.to.eql('MONEDA');",
                  "  });",
                  "});"
                ]
              }
