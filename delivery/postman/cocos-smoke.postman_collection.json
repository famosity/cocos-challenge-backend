    {
      "name": "Instrumentos",
      "item": [
        {
          "name": "Catálogo con paginación por defecto",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/instruments",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "instruments"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Catálogo con paginación por defecto', function () {",
                  "  pm.response.to.have.status(200);",
                  "  const { items, pagination } = pm.response.json();",
                  "  const expectedPage = 1;",
                  "  const expectedPageSize = 20;",
                  "  pm.expect(pagination.page, 'page').to.eql(expectedPage);",
                  "  pm.expect(pagination.pageSize, 'pageSize').to.eql(expectedPageSize);",
                  "  const totalItems = pagination.totalItems;",
                  "  pm.expect(Number.isSafeInteger(totalItems) && totalItems >= 0, 'totalItems entero no negativo').to.be.true;",
                  "  pm.expect(pagination.totalPages, 'totalPages').to.eql(Math.ceil(totalItems / expectedPageSize));",
                  "  const remaining = totalItems - (expectedPage - 1) * expectedPageSize;",
                  "  const expectedItems = Math.max(0, Math.min(expectedPageSize, remaining));",
                  "  pm.expect(items).to.be.an('array').with.lengthOf(expectedItems);",
                  "  items.forEach(function (instrument) {",
                  "    pm.expect(instrument).to.have.all.keys('id', 'ticker', 'name', 'type');",
                  "    pm.expect(instrument.ticker).not.to.eql('ARS');",
                  "    pm.expect(instrument.type).not.to.eql('MONEDA');",
                  "  });",
                  "});"
                ]
              }
            }
          ]
        },
