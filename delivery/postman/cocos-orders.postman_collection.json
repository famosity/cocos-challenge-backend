{
  "info": {
    "_postman_id": "cocos-orders",
    "name": "Cocos API — Órdenes válidas",
    "description": "Ocho órdenes válidas de compra y venta por monto o cantidad. Usá la semilla inicial. Cada solicitud inserta una orden, así que reiniciá la base de demo para repetir el recorrido.\r\n\r\nDesde la raíz: npx newman run delivery/postman/cocos-orders.postman_collection.json -e delivery/postman/local.postman_environment.json",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:3001"
    }
  ],
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test('incluye X-Request-Id', function () {",
          "  const requestId = pm.response.headers.get('X-Request-Id');",
          "  pm.expect(requestId).to.match(/^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i);",
          "});"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Compra MARKET por cantidad",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"userId\": 1,\n  \"instrumentId\": 34,\n  \"side\": \"BUY\",\n  \"type\": \"MARKET\",\n  \"quantity\": 1\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": { "raw": "{{baseUrl}}/orders", "host": ["{{baseUrl}}"], "path": ["orders"] },
        "description": "GGAL. Ejecuta 1 acción al último cierre (885.80) y descuenta ese importe."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('persiste FILLED', function () {",
              "  pm.response.to.have.status(201);",
              "  const body = pm.response.json();",
              "  pm.expect(body.status).to.eql('FILLED');",
              "  pm.expect(body.id).to.be.a('number');",
              "  pm.expect(body.reason).to.be.undefined;",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Compra MARKET por monto",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"userId\": 1,\n  \"instrumentId\": 34,\n  \"side\": \"BUY\",\n  \"type\": \"MARKET\",\n  \"amount\": \"1000.00\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": { "raw": "{{baseUrl}}/orders", "host": ["{{baseUrl}}"], "path": ["orders"] },
        "description": "GGAL a 885.80. El monto alcanza para 1 acción (885.80) y deja el resto sin usar. quantity y amount no van juntos."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('persiste FILLED', function () {",
              "  pm.response.to.have.status(201);",
              "  const body = pm.response.json();",
              "  pm.expect(body.status).to.eql('FILLED');",
              "  pm.expect(body.id).to.be.a('number');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Compra LIMIT por cantidad",
