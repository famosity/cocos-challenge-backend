    {
      "name": "Rechazo original",
      "item": [
        {
          "name": "Compra LIMIT sin fondos",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "idem-postman-rejected" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": 1,\n  \"instrumentId\": 34,\n  \"side\": \"BUY\",\n  \"type\": \"LIMIT\",\n  \"quantity\": 1,\n  \"price\": \"99999999.99\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/orders", "host": ["{{baseUrl}}"], "path": ["orders"] },
            "description": "El precio reserva más efectivo del que tiene el usuario 1. La orden queda REJECTED y la clave guarda ese resultado."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('persiste REJECTED', function () {",
                  "  pm.response.to.have.status(201);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.status).to.eql('REJECTED');",
                  "  pm.expect(body.reason).to.eql('INSUFFICIENT_FUNDS');",
                  "  pm.collectionVariables.set('rejectedId', String(body.id));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Reintento del rechazo",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "idem-postman-rejected" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": 1,\n  \"instrumentId\": 34,\n  \"side\": \"BUY\",\n  \"type\": \"LIMIT\",\n  \"quantity\": 1,\n  \"price\": \"99999999.99\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/orders", "host": ["{{baseUrl}}"], "path": ["orders"] },
            "description": "Repite el REJECTED original y su motivo, aunque un envío nuevo podría evaluarse de nuevo."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('repite el rechazo guardado', function () {",
                  "  pm.response.to.have.status(201);",
                  "  pm.expect(pm.response.json()).to.eql({",
                  "    id: Number(pm.collectionVariables.get('rejectedId')),",
                  "    status: 'REJECTED',",
                  "    reason: 'INSUFFICIENT_FUNDS'",
                  "  });",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
