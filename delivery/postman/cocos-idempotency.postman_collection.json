{
  "info": {
    "_postman_id": "cocos-idempotency",
    "name": "Cocos API — Idempotencia de órdenes",
    "description": "Prueba POST /orders con Idempotency-Key. Ejecutá primero el script de demo, que prepara la tabla necesaria. Hay casos que crean órdenes. Los reintentos devuelven el resultado guardado.\r\n\r\nDesde la raíz: npx newman run delivery/postman/cocos-idempotency.postman_collection.json -e delivery/postman/local.postman_environment.json",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://127.0.0.1:3001" }
  ],
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test('incluye X-Request-Id', function () {",
          "  const requestId = pm.response.headers.get('X-Request-Id');",
          "  pm.expect(requestId).to.match(/^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i);",
          "});"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Misma clave y mismo envío",
      "item": [
        {
          "name": "Primera compra MARKET por cantidad",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "idem-postman-qty" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": 1,\n  \"instrumentId\": 34,\n  \"side\": \"BUY\",\n  \"type\": \"MARKET\",\n  \"quantity\": 1\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/orders", "host": ["{{baseUrl}}"], "path": ["orders"] },
            "description": "GGAL. Crea la orden y guarda la clave idem-postman-qty."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('persiste FILLED y guarda el id', function () {",
                  "  pm.response.to.have.status(201);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.status).to.eql('FILLED');",
                  "  pm.expect(body.id).to.be.a('number');",
                  "  pm.collectionVariables.set('filledId', String(body.id));",
                  "  pm.collectionVariables.set('filledRequestId', pm.response.headers.get('X-Request-Id'));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Reintento de la misma compra",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "idem-postman-qty" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": 1,\n  \"instrumentId\": 34,\n  \"side\": \"BUY\",\n  \"type\": \"MARKET\",\n  \"quantity\": 1\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/orders", "host": ["{{baseUrl}}"], "path": ["orders"] },
            "description": "Misma clave y mismo cuerpo. Repite el 201 original y conserva su propio X-Request-Id."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('repite el id y usa otro request id', function () {",
                  "  pm.response.to.have.status(201);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body).to.eql({ id: Number(pm.collectionVariables.get('filledId')), status: 'FILLED' });",
                  "  pm.expect(pm.response.headers.get('X-Request-Id')).to.not.eql(pm.collectionVariables.get('filledRequestId'));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Misma clave con otra cantidad",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "idem-postman-qty" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": 1,\n  \"instrumentId\": 34,\n  \"side\": \"BUY\",\n  \"type\": \"MARKET\",\n  \"quantity\": 2\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/orders", "host": ["{{baseUrl}}"], "path": ["orders"] },
            "description": "La clave ya se usó para 1 acción. No inserta otra orden."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('rechaza la clave reutilizada', function () {",
                  "  pm.response.to.have.status(409);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.code).to.eql('IDEMPOTENCY_KEY_REUSED');",
                  "  pm.expect(body.requestId).to.eql(pm.response.headers.get('X-Request-Id'));",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
